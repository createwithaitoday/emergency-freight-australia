# Public brand. Change these in one place. Do not put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_BRAND_NAME=Emergency Freight Australia
NEXT_PUBLIC_BRAND_SHORT=Emergency Freight
NEXT_PUBLIC_POSITIONING=Australia's Emergency Delivery Service
NEXT_PUBLIC_PHONE_DISPLAY=1300 000 000
NEXT_PUBLIC_PHONE_TEL=+611300000000
NEXT_PUBLIC_DISPATCH_EMAIL=dispatch@example.com
NEXT_PUBLIC_DOMAIN=emergencyfreight.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_NAME=Emergency Freight Australia
NEXT_PUBLIC_ABN=

# Leave blank until the business has a real measurement id.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_PAYMENT_LABEL=

# Database. Omit DATABASE_URL to use the local PostgreSQL-compatible file in ./data/pglite.
# Set a postgres:// URL in production. Do not use the file database on serverless hosts.
# DATABASE_URL=postgres://efa:efa@localhost:5432/efa
PGDATA_DIR=./data/pglite

# Staff sign-in. Created on first boot when both values are set.
ADMIN_EMAIL=dispatch@example.com
ADMIN_PASSWORD=replace-this-password

# Both must be true before a verified metro job can be paid without a dispatcher.
# Leave PRICING_AUTO_ACCEPT unset until carrier rates have been checked.
PRICING_AUTO_ACCEPT=false

# Local only. Never enable this in production.
DEMO_PAYMENTS=false

# Routing. Without a key, distances are labelled unverified and cannot be confirmed automatically.
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# Payments. Use Stripe test keys until live payments are authorised.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email and SMS. If unset, messages are written to the server log outside production.
RESEND_API_KEY=
EMAIL_FROM=
DISPATCH_EMAIL=dispatch@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
